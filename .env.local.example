# Supabase 프로젝트 설정 (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 (Edge Function / 배치 작업 등에서만 사용, 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 카카오맵 (지역 실좌표 연동 시 사용, MVP 스키매틱 타일맵 단계에서는 불필요)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your-kakao-javascript-key
