# Supabase 프로젝트 설정 (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 — 절대 클라이언트에 노출 금지. lib/supabase/admin.ts(사진 원본 비공개 버킷
# 업로드), Edge Function/배치 작업 등에서 사용.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 카카오맵 (지역 실좌표 연동 시 사용, MVP 스키매틱 타일맵 단계에서는 불필요)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your-kakao-javascript-key

# Supabase 미연결 상태(목업 모드)에서 성능/부하 테스트용 더미 스팟 240개를 함께 노출할지 여부.
# 기본 false. 실제 서비스에는 절대 true로 배포하지 말 것.
NEXT_PUBLIC_INCLUDE_SYNTHETIC_TEST_SPOTS=false
